```groovy
pipeline {
    agent any

    options {
        // Ne pas cloner tout le portfolio dans le workspace.
        skipDefaultCheckout(true)

        // Empêcher deux opérations Pi-hole simultanées.
        disableConcurrentBuilds()

        // Ajouter les horodatages aux logs.
        timestamps()
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['install', 'enable', 'disable', 'uninstall'],
            description: 'Action à effectuer sur Pi-hole'
        )
    }

    stages {
        stage('Validation') {
            steps {
                script {
                    def allowedActions = [
                        'install',
                        'enable',
                        'disable',
                        'uninstall'
                    ]

                    if (!allowedActions.contains(params.ACTION)) {
                        error("Action non autorisée : ${params.ACTION}")
                    }

                    echo "Action demandée : ${params.ACTION}"
                }
            }
        }

        stage('Confirmation') {
            when {
                expression {
                    params.ACTION == 'uninstall'
                }
            }
            steps {
                input(
                    message: 'Confirmer la désinstallation de Pi-hole ?',
                    ok: 'Confirmer la désinstallation'
                )
            }
        }

        stage('Exécution') {
            steps {
                script {
                    switch (params.ACTION) {

                        case 'install':
                            sh 'sudo -n /usr/bin/systemctl start pihole-install.service'
                            break

                        case 'enable':
                            sh 'sudo -n /usr/bin/systemctl start pihole-enable.service'
                            break

                        case 'disable':
                            sh 'sudo -n /usr/bin/systemctl start pihole-disable.service'
                            break

                        case 'uninstall':
                            sh 'sudo -n /usr/bin/systemctl start pihole-uninstall.service'
                            break

                        default:
                            error('Action inconnue')
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Opération Pi-hole terminée avec succès."
        }

        failure {
            echo "Échec de l'opération Pi-hole. Consulter les logs Jenkins et systemd."
        }

        aborted {
            echo "Opération annulée."
        }
    }
}
```