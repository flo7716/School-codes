
#!/usr/bin/env bash
set -uo pipefail

INTERFACE="{{ pihole_interface }}"
ACTION="${2:-}"
PIHOLE_USER="{{ pihole_user }}"
PIHOLE_HOME="{{ pihole_home }}"
CONTAINER="{{ pihole_container }}"
DNS="{{ pihole_dns_address }}"
PORT="{{ pihole_dns_port }}"
CONTEXT="{{ docker_context }}"

# Ne gérer que l'interface configurée
[[ "${1:-}" == "$INTERFACE" ]] || exit 0

# Éviter les exécutions concurrentes
exec 9>/run/lock/pihole-networkmanager.lock
if ! flock -w 30 9; then
    logger -t pihole-networkmanager "Impossible d'obtenir le verrou réseau"
    exit 1
fi

restore_network_dns() {
    if resolvectl revert "$INTERFACE"; then
        logger -t pihole-networkmanager "DNS réseau restauré sur $INTERFACE"
    else
        logger -t pihole-networkmanager "ERREUR : restauration DNS impossible sur $INTERFACE"
    fi
}

# Déconnexion ou arrêt de l'interface
if [[ "$ACTION" == "down" || "$ACTION" == "pre-down" ]]; then
    restore_network_dns
    exit 0
fi

# Événements pris en charge
[[ "$ACTION" == "up" || "$ACTION" == "dhcp4-change" ]] || exit 0

PIHOLE_UID=$(id -u "$PIHOLE_USER") || exit 1
RUNTIME_DIR="/run/user/$PIHOLE_UID"

docker_cmd() {
    runuser -u "$PIHOLE_USER" -- \
        env HOME="$PIHOLE_HOME" \
            XDG_RUNTIME_DIR="$RUNTIME_DIR" \
        /usr/bin/docker --context "$CONTEXT" "$@"
}

logger -t pihole-networkmanager "Vérification de Docker Desktop"

# Attendre que Docker Desktop soit disponible
DOCKER_READY=false

for i in {1..60}; do
    if docker_cmd info >/dev/null 2>&1; then
        DOCKER_READY=true
        break
    fi
    sleep 2
done

if [[ "$DOCKER_READY" != "true" ]]; then
    logger -t pihole-networkmanager "Docker indisponible"
    restore_network_dns
    exit 0
fi

# Vérifier l'état du conteneur
RUNNING=$(docker_cmd inspect \
    -f '{{ "{{" }}.State.Running{{ "}}" }}' \
    "$CONTAINER" 2>/dev/null || true)

if [[ "$RUNNING" != "true" ]]; then
    logger -t pihole-networkmanager "Démarrage de Pi-hole"

    if ! docker_cmd start "$CONTAINER" >/dev/null; then
        logger -t pihole-networkmanager "Impossible de démarrer Pi-hole"
        restore_network_dns
        exit 0
    fi
fi

# Attendre une réponse DNS valide
DNS_READY=false

for i in {1..30}; do
    if dig +time=2 +tries=1 @"$DNS" -p "$PORT" example.com A +short |
        grep -qE '^[0-9]+\.'; then
        DNS_READY=true
        break
    fi
    sleep 2
done

if [[ "$DNS_READY" != "true" ]]; then
    logger -t pihole-networkmanager "Pi-hole ne répond pas"
    restore_network_dns
    exit 0
fi

# Appliquer le DNS Pi-hole uniquement après validation
if resolvectl dns "$INTERFACE" "$DNS:$PORT"; then
    logger -t pihole-networkmanager "DNS Pi-hole appliqué sur $INTERFACE"
else
    logger -t pihole-networkmanager "Échec d'application du DNS Pi-hole"
    restore_network_dns
    exit 1
fi
