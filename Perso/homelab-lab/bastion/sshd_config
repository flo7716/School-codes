# Bastion — configuration durcie
Port 22
HostKey /etc/ssh/hostkeys/ssh_host_ed25519_key

# Authentification : clé uniquement, un seul utilisateur
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
AllowUsers admin
MaxAuthTries 3
LoginGraceTime 20

# Rebond : uniquement des redirections locales (-L / ProxyJump),
# et seulement vers les destinations listées ici.
AllowTcpForwarding local
# (Nextcloud passe par le reverse proxy HTTPS, pas par le bastion)
PermitOpen 10.10.10.10:80
GatewayPorts no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no

ClientAliveInterval 300
ClientAliveCountMax 2
LogLevel VERBOSE
