{
	# Ne pas essayer d'installer la CA dans le conteneur
	skip_install_trust
}

{$NEXTCLOUD_DOMAIN} {
	tls internal

	encode gzip zstd
	request_body {
		max_size 10GB
	}

	# Découverte CalDAV / CardDAV (agenda et contacts GNOME)
	redir /.well-known/carddav /remote.php/dav/ 301
	redir /.well-known/caldav /remote.php/dav/ 301

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy 10.10.10.20:80
}
